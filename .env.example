# Optional: enables fresh AI word sets through the Gemini free tier.
# Create a key in Google AI Studio. Keep it server-side.
GEMINI_API_KEY=

# Optional text model override.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Optional: enables AI illustrations through Cloudflare Workers AI.
# Create a Workers AI token with Account.Workers AI:Read permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional image model override.
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
