{
  "name": "gmrc-hula-ang-salita",
  "productName": "GMRC - Hula ang Salita",
  "private": true,
  "version": "1.0.0",
  "description": "GMRC interactive word guessing game",
  "main": "electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:build:win": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.gmrc.hulaangsalita",
    "productName": "GMRC - Hula ang Salita",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs"
    ],
    "extraFiles": [
      {
        "from": "public/images",
        "to": "images",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "GMRC Hula ang Salita",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.0.0",
    "vite": "^8.0.0",
    "wait-on": "^8.0.0"
  }
}
